<%- include('partials/nav') %>

    <main class="container py-4">
      <% if (!patient) { %>
        <div class="alert alert-warning">Patient not found. <a href="/patients">Back to patients</a></div>
      <% } else { %>
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-start mb-3">
          <div><a href="/patients" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> All patients</a><h1 class="mb-0"><%= patient.name %></h1><div class="text-muted"><%= patient.age %> years · <%= patient.gender %></div></div>
          <div class="d-flex gap-2"><a class="btn btn-outline-primary" href="/patients/<%= patient.id %>/edit"><i class="bi bi-pencil me-1"></i>Edit details</a><a class="btn btn-primary" href="/appointments/new?patient=<%= patient.id %>"><i class="bi bi-plus-lg me-1"></i>Book appointment</a></div>
        </div>
        <div class="row g-4">
          <div class="col-lg-4"><div class="card shadow-sm"><div class="card-header bg-white"><strong>Patient information</strong></div><dl class="card-body mb-0"><dt class="small text-muted fw-normal">Date of birth</dt><dd class="mb-3"><%= patient.dob %></dd><dt class="small text-muted fw-normal">Phone</dt><dd class="mb-3"><%= patient.phone || "Not provided" %></dd><dt class="small text-muted fw-normal">Email</dt><dd class="mb-3"><%= patient.email || "Not provided" %></dd><dt class="small text-muted fw-normal">Address</dt><dd class="mb-3"><%= patient.address || "Not provided" %></dd><dt class="small text-muted fw-normal">Emergency contact</dt><dd class="mb-3"><%= patient.emergency || "Not provided" %></dd><dt class="small text-muted fw-normal">Referred by</dt><dd class="mb-3"><%= patient.referral || "Not provided" %></dd><dt class="small text-muted fw-normal">Presenting concern</dt><dd class="mb-3"><%= patient.concern || "Not provided" %></dd><dt class="small text-muted fw-normal">General notes</dt><dd class="mb-0"><%= patient.notes || "Not provided" %></dd></dl></div></div>
          <div class="col-lg-8"><div class="card shadow-sm"><div class="card-header bg-white"><strong>Appointments</strong></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Date</th><th>Type</th><th>Status</th><th>Payment</th><th>Notes</th><th></th></tr></thead><tbody>
            <% if (appointments.length) { %>
              <% appointments.forEach((appointment) => { %>
                <tr><td><%= appointment.formattedDate %><div class="small text-muted"><%= appointment.time %> · <%= appointment.duration %> min</div></td><td><%= appointment.type %><div class="small text-muted"><%= appointment.mode %></div></td><td><span class="badge text-bg-<%= statusClass[appointment.status] %>"><%= appointment.status %></span></td><td><% if (appointment.status === "Cancelled") { %><span class="text-muted small">n/a</span><% } else { %><span class="badge text-bg-<%= appointment.payment === "Paid" ? "success" : "warning" %>"><%= appointment.payment %></span> <span class="small text-muted"><%= appointment.formattedFee %></span><% } %></td><td><%= appointment.notes ? "Written" : "None yet" %></td><td class="text-end"><a class="btn btn-sm btn-primary" href="/appointment/<%= appointment.id %>">Open notes</a></td></tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="6" class="text-center text-muted py-4">No appointments yet. Book the first one.</td></tr>
            <% } %>
          </tbody></table></div></div></div>
        </div>
      <% } %>
    </main>
    <script src="/bjs/bootstrap.bundle.min.js"></script>
  </body>
</html>
