<%- include('partials/nav') %>

    <main class="container py-4">
      <div id="missing" class="alert alert-warning d-none">
        Patient not found. <a href="/patients">Back to patients</a>
      </div>
      <div id="content">
        <div
          class="d-flex flex-wrap gap-2 justify-content-between align-items-start mb-3"
        >
          <div>
            <a href="/patients" class="small text-decoration-none"
              ><i class="bi bi-arrow-left"></i> All patients</a
            >
            <h1 class="mb-0" id="pname"></h1>
            <div class="text-muted" id="psub"></div>
          </div>
          <div class="d-flex gap-2">
            <a id="editBtn" class="btn btn-outline-primary"
              ><i class="bi bi-pencil me-1"></i>Edit details</a
            ><a id="bookBtn" class="btn btn-primary"
              ><i class="bi bi-plus-lg me-1"></i>Book appointment</a
            >
          </div>
        </div>
        <div class="row g-4">
          <div class="col-lg-4">
            <div class="card shadow-sm">
              <div class="card-header bg-white">
                <strong>Patient information</strong>
              </div>
              <dl class="card-body mb-0" id="info"></dl>
            </div>
          </div>
          <div class="col-lg-8">
            <div class="card shadow-sm">
              <div class="card-header bg-white">
                <strong>Appointments</strong>
              </div>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Date</th>
                      <th>Type</th>
                      <th>Status</th>
                      <th>Payment</th>
                      <th>Notes</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody id="rows"></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/common.js"></script>
    <script src="/js/profile.js"></script>
  </body>
</html>
