<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Appointment notes · Mindleaf</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />
    <link href="css/style.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="img/favicon.svg" />
  </head>
  <body>
    <div id="nav"></div>
    <main class="container py-4">
      <div id="missing" class="alert alert-warning d-none">
        Appointment not found.
        <a href="appointments.html">Back to appointments</a>
      </div>
      <div id="content">
        <a id="back" class="small text-decoration-none"
          ><i class="bi bi-arrow-left"></i> Back to patient file</a
        >
        <div
          class="d-flex flex-wrap justify-content-between align-items-start mb-3"
        >
          <div>
            <h1 class="mb-0" id="who"></h1>
            <div class="text-muted" id="meta"></div>
          </div>
          <span id="stat" class="badge fs-6"></span>
        </div>
        <form class="card shadow-sm" id="form">
          <div class="card-header bg-white"><strong>Session notes</strong></div>
          <div class="card-body row g-3">
            <div class="col-md-6">
              <label class="form-label" for="mood">Mood and presentation</label
              ><input
                id="mood"
                class="form-control"
                placeholder="e.g. Anxious, tearful, calm"
              />
            </div>
            <div class="col-md-6">
              <label class="form-label" for="risk">Risk assessment</label
              ><select id="risk" class="form-select">
                <option>No concerns noted</option>
                <option>Monitor</option>
                <option>Elevated: follow safety protocol</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="summary">Session summary</label
              ><textarea id="summary" rows="5" class="form-control"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label" for="interventions"
                >Interventions used</label
              ><textarea
                id="interventions"
                rows="3"
                class="form-control"
              ></textarea>
            </div>
            <div class="col-12">
              <label class="form-label" for="progress"
                >Progress and observations</label
              ><textarea id="progress" rows="3" class="form-control"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label" for="plan">Plan and homework</label
              ><textarea id="plan" rows="3" class="form-control"></textarea>
            </div>
          </div>
          <div
            class="card-footer bg-white d-flex flex-wrap gap-2 justify-content-between align-items-center"
          >
            <span class="small text-muted" id="saved"></span>
            <div class="d-flex gap-2">
              <button type="button" class="btn btn-outline-primary" id="done">
                Save and mark completed</button
              ><button class="btn btn-primary">Save notes</button>
            </div>
          </div>
        </form>
      </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/common.js"></script>
    <script src="js/session.js"></script>
  </body>
</html>
