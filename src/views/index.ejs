  <%- include('partials/header') %>

    <header class="hero text-white">
      <div class="container py-5">
        <div class="row align-items-center py-md-4">
          <div class="col-lg-7">
            <span class="badge rounded-pill text-bg-light mb-3"
              >14-day free trial</span
            >
            <h1 class="display-5 fw-bold">
              Spend your time with patients, not paperwork.
            </h1>
            <p class="lead mb-4">
              Mindleaf keeps patient files, appointments, session notes and
              payments in one calm, simple place built for psychologists.
            </p>
            <a class="btn btn-light btn-lg me-2" href="/signup"
              >Start free trial</a
            >
            <a
              class="btn btn-outline-light btn-lg me-2"
              id="demoLaunch"
              href="/dashboard?demo=1"
              >Explore the demo</a
            >
            <a class="btn btn-outline-light btn-lg" href="/login">Log in</a>
            <p class="small mt-3 mb-0 text-white-50">
              No account needed. The demo opens with sample patients,
              appointments, notes and payment data.
            </p>
          </div>
        </div>
      </div>
    </header>

    <section id="features" class="container py-5">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Everything your practice needs</h2>
        <p class="text-muted">
          Four tools that work together, with nothing to install.
        </p>
      </div>
      <div class="row g-4">
        <div class="col-md-6 col-lg-3">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <i class="bi bi-person-lines-fill fs-1 text-primary"></i>
              <h3 class="h5 mt-3">Patient files</h3>
              <p class="text-muted mb-0">
                Contact details, emergency contact, referral source and
                presenting concern, with every appointment listed on the
                patient's page.
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <i class="bi bi-calendar-check fs-1 text-primary"></i>
              <h3 class="h5 mt-3">Appointments</h3>
              <p class="text-muted mb-0">
                Book individual, couples, family and follow-up sessions in
                person, by video or by phone, and track their status.
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <i class="bi bi-journal-text fs-1 text-primary"></i>
              <h3 class="h5 mt-3">Session notes</h3>
              <p class="text-muted mb-0">
                A structured note for every appointment: mood, risk assessment,
                summary, interventions, progress and plan.
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <i class="bi bi-cash-coin fs-1 text-primary"></i>
              <h3 class="h5 mt-3">Payments overview</h3>
              <p class="text-muted mb-0">
                See which appointments are paid, which are not, and the total
                outstanding, right on your dashboard.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-5">
      <div class="container">
        <div class="row g-4 text-center">
          <div class="col-md-4">
            <div class="display-6 text-primary">
              <i class="bi bi-1-circle"></i>
            </div>
            <h3 class="h5 mt-2">Create your account</h3>
            <p class="text-muted">Sign up in under a minute and pick a plan.</p>
          </div>
          <div class="col-md-4">
            <div class="display-6 text-primary">
              <i class="bi bi-2-circle"></i>
            </div>
            <h3 class="h5 mt-2">Add your patients</h3>
            <p class="text-muted">
              Enter each patient once and book their appointments.
            </p>
          </div>
          <div class="col-md-4">
            <div class="display-6 text-primary">
              <i class="bi bi-3-circle"></i>
            </div>
            <h3 class="h5 mt-2">Write notes and track payments</h3>
            <p class="text-muted">
              Keep notes with each session and mark payments as they arrive.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="pricing" class="container py-5">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Simple monthly pricing</h2>
        <p class="text-muted">
          Every plan starts with a 14-day free trial. Cancel any time.
        </p>
      </div>
      <div class="row g-4 justify-content-center">
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h3 class="h5">Starter</h3>
              <div class="my-3">
                <span class="display-6 fw-bold">$19</span>
                <span class="text-muted"> / month</span>
              </div>
              <ul class="list-unstyled flex-grow-1">
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>1 practitioner
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Up to 25
                  patients
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Appointments and
                  session notes
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Dashboard
                </li>
              </ul>
              <a class="btn btn-outline-primary" href="/dashboard"
                >Open dashboard</a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow border-primary border-2">
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between">
                <h3 class="h5">Professional</h3>
                <span class="badge text-bg-primary align-self-start"
                  >Most popular</span
                >
              </div>
              <div class="my-3">
                <span class="display-6 fw-bold">$39</span>
                <span class="text-muted"> / month</span>
              </div>
              <ul class="list-unstyled flex-grow-1">
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>1 practitioner
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Unlimited
                  patients
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Everything in
                  Starter
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Payments
                  overview and outstanding totals
                </li>
              </ul>
              <a class="btn btn-primary" href="/dashboard"
                >Open dashboard</a
              >
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h3 class="h5">Clinic</h3>
              <div class="my-3">
                <span class="display-6 fw-bold">$89</span
                ><span class="text-muted"> / month</span>
              </div>
              <ul class="list-unstyled flex-grow-1">
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Up to 5
                  practitioners
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Unlimited
                  patients
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Everything in
                  Professional
                </li>
                <li class="mb-2">
                  <i class="bi bi-check2 text-success me-2"></i>Priority support
                </li>
              </ul>
              <a class="btn btn-outline-primary" href="/dashboard"
                >Open dashboard</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="hero text-white text-center py-5">
      <div class="container py-3">
        <h2 class="fw-bold">Ready to simplify your practice?</h2>
        <a class="btn btn-light btn-lg mt-3" href="/dashboard"
          >Open dashboard</a
        >
      </div>
    </section>
    <footer class="py-4 text-center text-muted small">
      &copy; <span id="yr"></span> Mindleaf
    </footer>
    <script src="/bjs/bootstrap.bundle.min.js"></script>
    <script src="js/landing.js"></script>
  </body>
</html>
